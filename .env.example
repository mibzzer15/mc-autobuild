# Auth mode: "cookie" (paste your session cookie) or "playwright" (interactive browser login)
MC_AUTH_MODE=cookie

# Required for MC_AUTH_MODE=cookie: paste the full "Cookie" request header value from your
# browser's devtools (Network tab -> any missionchief.com request -> Headers -> Cookie).
# Never share this value or commit it - it's equivalent to your login session.
MC_SESSION_COOKIE=

# Base URL of your MissionChief server. Change this for other localized game domains
# (e.g. https://www.leitstellenspiel.de).
MC_BASE_URL=https://www.missionchief.com

# Where the Playwright-captured session is stored (MC_AUTH_MODE=playwright only).
MC_STORAGE_STATE_PATH=storage_state.json
