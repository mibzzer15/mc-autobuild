# Auth mode: "credentials" (username/password), "cookie" (paste a session cookie), or
# "playwright" (interactive browser login).
MC_AUTH_MODE=credentials

# Required for MC_AUTH_MODE=credentials. The app logs in with these directly and caches the
# resulting session (see MC_STORAGE_STATE_PATH) so it doesn't have to log in again every run.
# NOTE: this stores your password in plaintext in this file. Keep .env's permissions locked down
# (chmod 600 .env) and never commit it - it's gitignored by default for that reason.
MC_USERNAME=
MC_PASSWORD=

# Required for MC_AUTH_MODE=cookie: paste the full "Cookie" request header value from your
# browser's devtools (Network tab -> any missionchief.com request -> Headers -> Cookie).
# Never share this value or commit it - it's equivalent to your login session.
MC_SESSION_COOKIE=

# Base URL of your MissionChief server. Change this for other localized game domains
# (e.g. https://www.leitstellenspiel.de).
MC_BASE_URL=https://www.missionchief.com

# Where the session is cached: the Playwright-captured session (MC_AUTH_MODE=playwright), or the
# session established via MC_AUTH_MODE=credentials so it can be reused across runs.
MC_STORAGE_STATE_PATH=storage_state.json
